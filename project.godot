; Fichier de configuration du moteur Godot.
; Il est conseillé de le modifier via Projet > Paramètres du projet.

config_version=5

[application]

config/name="FanAroundTheWorld"
config/description="Gestion de fan club et voyage autour des vrais matchs de football."
config/version="0.4.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Donnees="*res://scripts/autoload/donnees.gd"
Reseau="*res://scripts/autoload/reseau.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/fallback="fr"

[gui]

common/snap_controls_to_pixels=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.117647, 0.419608, 1, 1)
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=false
